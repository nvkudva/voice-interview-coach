# ---- LiveKit -----------------------------------------------------------
# LiveKit Cloud. Self-hosting is out of scope for v1 (prd.md D1), but only
# this URL changes if that reverses.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Models: provider/model. Never hardcoded in the agent. -------------
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi          # one model for English + Hindi + code-switching
STT_FALLBACK=

LLM_MODEL=anthropic/claude-sonnet-4-6
LLM_FALLBACK=openai/gpt-4o-mini

TTS_MODEL=cartesia/sonic-3
TTS_FALLBACK=elevenlabs/eleven_turbo_v2_5

# Per-language voices. TTS_VOICE_<LANG> wins over TTS_VOICE.
TTS_VOICE=
TTS_VOICE_EN=
TTS_VOICE_HI=

# ---- The interview room ------------------------------------------------
# A photoreal avatar joins the call and the candidate's camera is on, so a
# practice run looks like the real thing. AVATAR_ENABLED=false falls back to
# voice only — and to roughly a fifth of the cost. See docs/cost.md.
AVATAR_ENABLED=true
AVATAR_MODEL=lemonslice        # lemonslice | tavus/<replica> | bey/<avatar> | simli
AVATAR_JOIN_TIMEOUT=20         # seconds; past this the call proceeds voice-only
CAMERA_ENABLED=true

# ---- Provider keys -----------------------------------------------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
TAVUS_API_KEY=
BEY_API_KEY=
OPENAI_API_KEY=

# ---- Turn handling (tuned; see docs/tuning.md) -------------------------
COACH_LANGUAGE=en
ENDPOINTING_MODE=dynamic
MIN_ENDPOINTING_DELAY=0.3
MAX_ENDPOINTING_DELAY=2.5
INTERRUPTION_MODE=adaptive
MIN_INTERRUPTION_DURATION=0.5
PREEMPTIVE_GENERATION=true
PREEMPTIVE_TTS=false        # cuts latency, costs money on discarded drafts

# Silero defaults to 0.55 s, which alone blows the 800 ms budget.
VAD_MIN_SILENCE=0.2
VAD_MIN_SPEECH=0.05

# ---- Operations --------------------------------------------------------
DATA_DIR=data/sessions
RETENTION_DAYS=30
COST_CEILING_USD=0.85   # with avatar video. Voice-only lands near $0.15.
CORS_ORIGINS=*
